# IA NOC Agent Backend Configuration

# Server
PORT=3001
HOST=localhost
NODE_ENV=development

# Database
DB_PATH=./data/agent.json

# File System
PROJECTS_ROOT=../..
SCAN_INTERVAL_MINUTES=30
MAX_FILE_SIZE_MB=10

# AI/LLM (configure your provider)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

# Agent Identity
AGENT_NAME=IA NOC
AGENT_VERSION=1.0.0
DEFAULT_LANGUAGE=pt-BR

# Learning
AUTO_LEARN=true
MAX_CONTEXT_FILES=20
VERBOSITY=normal

# Security
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=your-secret-key-here
# ================= Assistente NOC =================
# Quem responde: nativo (padrão; motor próprio, sem IA externa), anthropic, groq, gemini,
# openrouter, openai ou ollama.
LLM_PROVIDER=nativo

# Claude (Anthropic). O SDK também aceita ANTHROPIC_AUTH_TOKEN ou um perfil de
# `ant auth login` (nesse caso defina CLAUDE_ENABLED=true).
# ANTHROPIC_API_KEY=sk-ant-...  (deixe comentado se usar perfil do `ant auth login`; vazio atrapalha)
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high
CLAUDE_MAX_TOOL_ROUNDS=12
CLAUDE_MAX_HISTORY_TURNS=20

# Sistema NOC (sistema.updown.com.br). Crie um usuário de serviço com perfil
# só de leitura (Atendimento ou Analista) e permissões zabbix.view,
# topology.view, clientes.view e radius.view.
NOC_API_URL=https://sistema.updown.com.br
NOC_API_USER=
NOC_API_PASSWORD=
# Alternativa ao usuário/senha: token de sessão fixo (expira com SESSION_HOURS)
NOC_API_TOKEN=

# Zabbix direto (JSON-RPC, só .get). Até 3 instâncias: ZABBIX_*, ZABBIX2_*, ZABBIX3_*.
ZABBIX_NAME=updown
ZABBIX_URL=http://190.111.110.13:19090/api_jsonrpc.php
# Token de API (preferido) OU usuário/senha de um usuário só leitura
ZABBIX_TOKEN=
ZABBIX_USER=
ZABBIX_PASSWORD=
# Segunda e terceira instâncias, opcionais (mesmas chaves com ZABBIX2_ / ZABBIX3_)
# ZABBIX2_NAME=lv
# ZABBIX2_URL=https://zbx7.lv.network/api_jsonrpc.php
# ZABBIX2_TOKEN=

# GenieACS NBI (porta 7557). Só por rede interna ou túnel SSH:
#   ssh -L 7557:127.0.0.1:7557 noc@<vm-do-acs>
GENIEACS_NBI_URL=
GENIEACS_NBI_USER=
GENIEACS_NBI_PASSWORD=

# IXC Soft webservice v1 (ex.: https://ixc.seudominio.com.br/webservice/v1)
# Token no formato "id:token" de um usuário de API só com permissão de listar.
IXC_BASE_URL=
IXC_API_TOKEN=

# ---------------- Opa! Suite (atendimento) — token de perfil de API só leitura;
# libere o IP deste servidor em "Redes permitidas" no Opa!
OPA_URL=https://opasuite.updown.com.br
OPA_TOKEN=

# ---------------- Voz (opcional): transcrição no servidor para navegadores sem
# reconhecimento de fala. Ex.: Groq grátis https://api.groq.com/openai/v1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3

# Base de conhecimento (padrões: ../../Topologia-NOC.github.io/public/data e ../knowledge)
# TOPOLOGIA_DATA_DIR=
# KNOWLEDGE_DIR=
CONNECTOR_TIMEOUT_MS=20000
TOOL_RESULT_MAX_CHARS=40000

# ---------------- Voz das respostas (TTS)
# edge  = voz neural da Microsoft no servidor (padrão; TTS_VOICE=pt-BR-FranciscaNeural)
# fish  = Fish Audio (https://fish.audio): crie a chave em fish.audio/app/api-keys e copie o
#         ID do modelo de voz escolhido na biblioteca. Use uma voz original ou licenciada
#         (não clones de pessoas reais sem autorização). Se a Fish falhar, cai na voz edge.
# kokoro = voz local no servidor (Kokoro-82M, Apache 2.0), sem internet nem créditos;
#         baixa o modelo (~325 MB) uma vez para KOKORO_CACHE_DIR. Vozes pt-BR:
#         pf_dora (feminina), pm_alex, pm_santa (masculinas).
# browser = só a voz do navegador
TTS_PROVIDER=edge
# FISH_API_KEY=
# FISH_VOICE_ID=
# FISH_MODEL=s1
# KOKORO_VOICE=pf_dora
# KOKORO_DTYPE=fp32   (q8: modelo menor e mais lento na CPU)
# KOKORO_SPEED=1
# KOKORO_CACHE_DIR=/var/lib/ianoc/models

# ---------------- Pesquisa na web (manuais)
# Uma API de busca oficial: Tavily (plano gratuito com créditos) ou Brave; ou SearXNG próprio.
# Sem nenhuma, a NIA consulta só a Wikipédia e os links informados na pergunta.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=

# ---------------- Administrador master (local)
# IANOC_ADMIN_USER=
# IANOC_ADMIN_NAME=
# IANOC_ADMIN_PASSWORD=   (senha inicial; troca obrigatória no primeiro acesso)

# /etc/ianoc/ianoc.env — ambiente do IA NOC no servidor (systemd EnvironmentFile).
# Permissão: root:ianoc 640. Um NOME=valor por linha, sem aspas e sem "export".

NODE_ENV=production
HOST=0.0.0.0
PORT=8090

# Só estes IPs alcançam o assistente (vírgula; aceita CIDR IPv4). Aplicado no
# firewall do servidor (deploy/firewall.sh) e também pela própria aplicação.
IANOC_ALLOWED_IPS=190.111.111.65

# Login: usuário e senha do sistema NOC. Perfis liberados (cliente nunca entra).
IANOC_AUTH=noc
IANOC_ALLOWED_ROLES=administrador,analista,tecnico,atendimento,logistica
IANOC_SESSION_HOURS=12
# Sem HTTPS o cookie não pode ser Secure. Ligue quando houver TLS na frente.
COOKIE_SECURE=false

# Dados e conhecimento
DB_PATH=/var/lib/ianoc/agent.json
TOPOLOGIA_DATA_DIR=/opt/ianoc/current/topologia-data
KNOWLEDGE_DIR=/opt/ianoc/current/knowledge
FRONTEND_DIST=/opt/ianoc/current/frontend/dist

# ---------------- Modelo de IA
# Modelo de IA. LLM_PROVIDER escolhe quem responde:
#   nativo     motor próprio do IA NOC (padrão): entende as perguntas do NOC e
#              responde com os dados dos sistemas, sem IA externa, sem chave e
#              sem limite de uso. Relatórios com análise por regras.
#   anthropic  Claude (pago; usa ANTHROPIC_API_KEY abaixo) — padrão
#   ollama     modelo local e gratuito, nada sai da rede (instale o Ollama e
#              baixe o modelo: ollama pull qwen3:8b). Sem chave.
#   gemini     Google AI Studio, cota gratuita (chave em aistudio.google.com).
#              ATENÇÃO: na cota gratuita o Google pode usar o conteúdo para
#              melhorar produtos; dados de cliente do IXC iriam junto.
#   groq       cota gratuita (chave em console.groq.com), limite baixo de
#              tokens por minuto para o tamanho do prompt do NOC.
#   openrouter modelos ":free" (chave em openrouter.ai)
#   openai     ou qualquer servidor compatível, com LLM_BASE_URL
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=
# OLLAMA_NUM_CTX=16384
# OLLAMA_THINK=true

LLM_PROVIDER=nativo
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# ---------------- Sistema NOC (obrigatório para o login)
NOC_API_URL=https://sistema.updown.com.br
# Usuário de serviço só leitura para as consultas do assistente
NOC_API_USER=
NOC_API_PASSWORD=

# ---------------- Zabbix
ZABBIX_NAME=updown
ZABBIX_URL=http://190.111.110.13:19090/api_jsonrpc.php
# Token de API (preferido) OU usuário/senha de um usuário só leitura
ZABBIX_TOKEN=
ZABBIX_USER=
ZABBIX_PASSWORD=
# Segunda e terceira instâncias, opcionais (mesmas chaves com ZABBIX2_ / ZABBIX3_)
# ZABBIX2_NAME=lv
# ZABBIX2_URL=https://zbx7.lv.network/api_jsonrpc.php
# ZABBIX2_TOKEN=

# ---------------- GenieACS NBI (rede interna)
GENIEACS_NBI_URL=

# ---------------- IXC
IXC_BASE_URL=
IXC_API_TOKEN=

# ---------------- Opa! Suite (atendimento) — token de perfil de API só leitura;
# libere o IP deste servidor em "Redes permitidas" no Opa!
OPA_URL=https://opasuite.updown.com.br
OPA_TOKEN=

# ---------------- Voz (opcional): transcrição no servidor para navegadores sem
# reconhecimento de fala. Ex.: Groq grátis https://api.groq.com/openai/v1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3

# ---------------- Voz das respostas (TTS)
# edge  = voz neural da Microsoft no servidor (padrão; TTS_VOICE=pt-BR-FranciscaNeural)
# fish  = Fish Audio (https://fish.audio): crie a chave em fish.audio/app/api-keys e copie o
#         ID do modelo de voz escolhido na biblioteca. Use uma voz original ou licenciada
#         (não clones de pessoas reais sem autorização). Se a Fish falhar, cai na voz edge.
# kokoro = voz local no servidor (Kokoro-82M, Apache 2.0), sem internet nem créditos;
#         baixa o modelo (~325 MB) uma vez para KOKORO_CACHE_DIR. Vozes pt-BR:
#         pf_dora (feminina), pm_alex, pm_santa (masculinas).
# browser = só a voz do navegador
TTS_PROVIDER=edge
# FISH_API_KEY=
# FISH_VOICE_ID=
# FISH_MODEL=s1
# KOKORO_VOICE=pf_dora
# KOKORO_DTYPE=fp32   (q8: modelo menor e mais lento na CPU)
# KOKORO_SPEED=1
# KOKORO_CACHE_DIR=/var/lib/ianoc/models

# ---------------- Pesquisa na web (manuais)
# Uma API de busca oficial: Tavily (plano gratuito com créditos) ou Brave; ou SearXNG próprio.
# Sem nenhuma, a NIA consulta só a Wikipédia e os links informados na pergunta.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_URL=

# ---------------- Administrador master (local)
# IANOC_ADMIN_USER=
# IANOC_ADMIN_NAME=
# IANOC_ADMIN_PASSWORD=   (senha inicial; troca obrigatória no primeiro acesso)
